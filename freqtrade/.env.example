# Copy to user_data/.env and fill in real values. Never commit the filled-in
# file — user_data/.env is gitignored.
#
# These use freqtrade's built-in environment-variable override convention
# (FREQTRADE__<SECTION>__<KEY>, uppercase, double underscore for nesting).
# freqtrade reads them at startup and overrides the matching config.json
# value — config.json.example intentionally leaves these blank so secrets
# never have to be written into the config file itself.
# Docs: https://www.freqtrade.io/en/stable/configuration/#environment-variables

# Binance API key — trading permission only, withdrawals DISABLED,
# restricted to your server's IP if possible.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# freqtrade's own REST API auth (what server/'s FREQTRADE_API_USERNAME /
# FREQTRADE_API_PASSWORD in the app's deployment must match).
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
