# Copy to user_data/.env and fill in real values. Never commit the filled-in file.
# Create a Binance API key with Spot/Futures trading enabled and
# withdrawals DISABLED, restricted to your server's IP if possible.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Used by config.json's api_server block (freqtrade's built-in REST API auth).
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=
FREQTRADE_JWT_SECRET=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
